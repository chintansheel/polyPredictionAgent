# LLM backend: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
# Used when LLM_PROVIDER=openai (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
# Default matches requested OpenAI model id; override if your account uses a different id.
OPENAI_MODEL=gpt-5-mini
# gpt-5 / o-series only: "minimal" | "low" | "medium" | "high".
# "low" keeps cost down; raise to "medium"/"high" for tougher synthesis.
# Set blank to disable (legacy non-reasoning OpenAI models).
OPENAI_REASONING_EFFORT=low
# Per-layer output budgets for OpenAI. Reasoning tokens count against
# these caps, so they need to be larger than the Anthropic equivalents.
OPENAI_MAX_TOKENS_LAYER1=4000
OPENAI_MAX_TOKENS_LAYER2=4000
OPENAI_MAX_TOKENS_LAYER3=8000
OPENAI_MAX_TOKENS_LAYER4=8000

TAVILY_API_KEY=tvly-...
EXA_API_KEY=exa-...
RUN_INTERVAL_HOURS=2
MAX_RETRIES=3
OUTPUT_DIR=./output
TRACES_DIR=./traces
STATE_DIR=./state
# Must match a model id from Anthropic docs (not arbitrary strings).
ANTHROPIC_MODEL=claude-sonnet-4-6
# Anthropic counts BOTH input tokens AND reserved max_tokens toward your TPM
# budget. The final card JSON is small; 1500 is plenty.
ANTHROPIC_MAX_TOKENS=1500
# Low TPM tiers: on HTTP 429 wait and retry. LLM_429_RETRY_MAX = total attempts per call (capped at 20).
LLM_429_RETRY_MAX=6
LLM_429_RETRY_WAIT_SECONDS=60
# Optional: seconds to sleep between LLM turns (spreads load; try 5-15 if you still 429).
LLM_INTER_TURN_SECONDS=0
# Optional: minimum seconds after each successful Messages call (and after each 429 wait).
LLM_MIN_SECONDS_BETWEEN_API=0
COOLDOWN_HOURS=48

# Web app (landing, auth, protected feed, user-driven runs)
AUTH_SECRET=change-me-to-a-long-random-string
USERS_DB_PATH=./state/users.db
WEB_PORT=8000
# Max simultaneous agent runs across all users (LLM rate limits)
WEB_MAX_CONCURRENT_RUNS=1
# Max runs a single user can start per calendar day (UTC)
WEB_RUNS_PER_USER_PER_DAY=5

# Password reset (Brevo transactional email)
# API key: Brevo dashboard → SMTP & API → API keys
# Sender must be a verified domain/sender in Brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=Foretell
RESET_PASSWORD_BASE_URL=http://localhost:8000
RESET_TOKEN_MAX_AGE=3600
